# Production settings. server-setup.sh copies this to .env.prod and fills in the generated
# values. Never commit .env.prod.

# Generated by server-setup.sh
POSTGRES_PASSWORD=
JWT_SECRET=

# Google sign-in: OAuth client from Google Cloud console (see DEPLOYMENT.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails with admin rights (runs, evals, users).
ADMIN_EMAILS=

# LLM ranking (OpenRouter)
OPENROUTER_API_KEY=

# Email digest (Resend). Leave empty until the domain is verified in Resend.
RESEND_API_KEY=
DIGEST_FROM=Job Search Agent <digest@jobs.aicruit.in>

PUBLIC_URL=https://jobs.aicruit.in
DAILY_RUN_TIME_IST=05:00

# AI limits: per user per day, and LLM calls per day across all users.
USER_DAILY_RANK_LIMIT=20
USER_DAILY_BRIEF_LIMIT=3
LLM_DAILY_CAP=800
