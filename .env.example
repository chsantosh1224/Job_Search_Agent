DATABASE_URL=postgresql+psycopg://jobagent:jobagent@127.0.0.1:5434/jobagent
OPENROUTER_API_KEY=

# Session cookie signing key: any long random string.
JWT_SECRET=

# Google sign-in (optional locally; see DEPLOYMENT.md). Admins by email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
PUBLIC_URL=http://127.0.0.1:8000

# Local development only: sign in by email without Google, from this machine.
DEV_LOGIN=false

# Email digest (Resend). DIGEST_FROM's domain must be verified in Resend.
RESEND_API_KEY=
DIGEST_FROM=Job Search Agent <digest@jobs.aicruit.in>
DAILY_RUN_TIME_IST=05:00
